generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Report {
  id          String   @id @default(uuid())
  userId      String   
  createdAt   DateTime @default(now())
  
  // Quick access fields
  summary     String
  redFlags    String[] 
  dietaryTips String[]
  
  // Full raw data
  carePlan    Json

  // Relations
  messages    Message[]
  metrics     HealthMetric[]
}

model Message {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  role      String   // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now())
}

model PatientProfile {
  id              String   @id @default(uuid())
  userId          String   @unique // One profile per user
  conditions      String[] // e.g. ["Diabetes", "Hypertension"]
  medications     String[] // e.g. ["Metformin 500mg", "Lisinopril 10mg"]
  allergies       String[] // e.g. ["Penicillin", "Peanuts"]
  bloodType       String?
  height          String?
  weight          String?
  additionalNotes String?  // Free text for AI to store other nuances
  
  updatedAt       DateTime @updatedAt
}

model HealthMetric {
  id          String   @id @default(uuid())
  userId      String
  reportId    String?
  report      Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  name        String   // Display name from report (e.g. "HbA1c", "Glycated Hb")
  canonicalName String // STANDARDIZED Key (e.g. "hba1c", "hemoglobin")
  
  value       Float    
  unit        String   // original unit
  unitNormalized String? // e.g. "g/dL" (Standardized)
  
  status      String?  
  
  measuredAt  DateTime 
  createdAt   DateTime @default(now())
}
